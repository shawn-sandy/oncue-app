---
import Base from '#layouts/Base.astro'
import ExternalLink from '#components/astro/ExternalLink.astro'
import HomeHero from '#components/astro/HomeHero.astro'
import InstallDialog from '#components/astro/InstallDialog.astro'
import MainSection from '#components/astro/MainSection.astro'
import WorkflowStrip from '#components/astro/WorkflowStrip.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '#utils/site-config'

// The OnCue plugin page. `Base` + `MainSection` rather than `Layout`, which
// always renders the blog sidebar; `MainSection` keeps the skip-link target.
const README = 'https://github.com/shawn-sandy/oncue'
const INSTALL_HREF = `${README}#install`
const COMMANDS = ['/plugin marketplace add shawn-sandy/oncue', '/plugin install oncue@oncue']
---

<Base pageTitle={SITE_TITLE} pageDescription={SITE_DESCRIPTION} hideHeader>
  <MainSection showBreadcrumb={false}>
    <HomeHero installHref={INSTALL_HREF} />
    <WorkflowStrip
      eyebrow="One idea. One connected workflow."
      title="From your first beat to the final frame."
      phases={['Storyboard', 'Voiceover', 'Editable deck', 'Finished video']}
    />
    <p class="home-closing" data-ui="label">
      <span>Made for Shorts, Reels, TikTok and YouTube.</span>
      <ExternalLink href={`${README}#usage`}>You direct. Claude brings it together.</ExternalLink>
    </p>
    <InstallDialog id="install" commands={COMMANDS} fallbackHref={INSTALL_HREF} />
  </MainSection>
</Base>

<style>
  /* The composition owns the spacing between its parts (DESIGN.md). */
  :global(main:has([data-home-hero])) {
    padding-block: 0;
  }

  :global(main:has([data-home-hero]) > [data-workflow-strip]) {
    margin-block-start: 0;
    margin-inline: 1.25rem;
    padding-inline: 0;

    /* The vendor fixes `main > section` to the content width, which the
       margins would push past the viewport. */
    width: auto;
  }

  .home-closing {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    line-height: 1.7;
    margin: 0;
    max-width: none;
    padding: 1.25rem 1.25rem 2rem;
    text-transform: none;
  }

  /* The vendor sizes every link at 1rem; here the link is part of the label line. */
  .home-closing :global(a) {
    font-size: inherit;
  }
</style>
