---
/**
 * Homepage section: the latest blog posts, each a card with its title as the
 * one link, a date and a short excerpt. Built on `FeatureSection` and its
 * `feature-grid` / `feature-card` parts.
 *
 * Posts come from `load`, which defaults to hardcoded placeholders until a real
 * source exists. The section has three states, marked by `data-blog-state` on
 * its body: `ready` (the list), `empty` (no posts) and `error` (`load` threw).
 * The error is logged on the server and the page says only that posts could not
 * load, so no internal detail reaches a visitor.
 *
 * Each post has exactly one tab stop, its title link, so keyboard order follows
 * the reading order. The link takes the global focus ring (2px OnCue Rust,
 * 2px offset); the accent stays on the link, never on the card or heading.
 *
 * @component FeatureBlog
 * @example
 * ```astro
 * <FeatureBlog />
 * <FeatureBlog load={async () => []} />
 * ```
 */
import FeatureSection from '#components/astro/FeatureSection.astro'

/** One post as the section lists it. */
export type BlogPostSummary = {
  title: string
  /** ISO calendar date, `YYYY-MM-DD`. */
  date: string
  excerpt: string
  href: string
}

export type Props = {
  /** Returns the posts to list, newest first. Defaults to the placeholders. */
  load?: () => Promise<readonly BlogPostSummary[]>
}

// ponytail: placeholder posts; swap `load` for a real source when posts exist.
// Each links to the blog index, a real page, rather than a post that 404s.
const PLACEHOLDER_POSTS: readonly BlogPostSummary[] = [
  {
    title: 'Storyboarding a Short in ten minutes',
    date: '2026-11-18',
    excerpt: 'From a bare topic to a beat list with cue words, and what to cut before recording.',
    href: '/blog/',
  },
  {
    title: 'Why every element enters on a word',
    date: '2026-11-04',
    excerpt: 'Word timestamps keep slides and voiceover in step, even after a retake.',
    href: '/blog/',
  },
  {
    title: 'One spec, four outputs',
    date: '2026-10-21',
    excerpt: 'How short.json drives the storyboard, the script, the deck and the video.',
    href: '/blog/',
  },
]

const { load = async () => PLACEHOLDER_POSTS } = Astro.props

let posts: readonly BlogPostSummary[] = []
let failed = false
try {
  posts = await load()
} catch (error) {
  failed = true
  console.error('FeatureBlog: posts failed to load', error)
}

const state = failed ? 'error' : posts.length === 0 ? 'empty' : 'ready'

// UTC, so a midnight ISO date never shifts a day in the server's timezone.
const formatDate = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long', timeZone: 'UTC' })
---

<FeatureSection id="blog-title" eyebrow="From the blog" title="Notes on making explainers.">
  <Fragment slot="deck">Short write-ups on how OnCue builds a video, and why.</Fragment>

  <div class="blog" data-blog-state={state}>
    {
      state === 'ready' && (
        <ul class="feature-grid blog__list" role="list">
          {posts.map(post => (
            <li>
              <article class="feature-card blog__post">
                <h3 class="feature-title">
                  <a href={post.href} class="blog__link">
                    {post.title}
                  </a>
                </h3>
                <time class="blog__date" data-ui="label" datetime={post.date}>
                  {formatDate.format(new Date(post.date))}
                </time>
                <p class="feature-muted">{post.excerpt}</p>
              </article>
            </li>
          ))}
        </ul>
      )
    }
    {state === 'empty' && <p class="feature-muted">No posts yet. Check back soon.</p>}
    {state === 'error' && <p class="feature-muted">Posts could not be loaded. Try again later.</p>}
  </div>
</FeatureSection>

<style>
  .blog__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .blog__list li {
    display: flex;
    margin: 0;
  }

  /* Cards in a row match heights. */
  .feature-card.blog__post {
    flex: 1;
  }

  /* The date shows above the title; the title stays first in source so a
     screen reader starts each card with it. The date holds no tab stop, so
     focus order is unchanged. */
  .blog__date {
    order: -1;
  }

  /* The vendor sizes every link at 1rem from `a[href]` (0,1,1); `[href]`
     lifts this to (0,2,0) so the link takes the title's size. The vendor
     also eases every property over 0.35s, which animated the focus ring;
     DESIGN.md allows colour only, 150ms. */
  .blog__link[href] {
    font-size: inherit;
    transition: color 150ms ease-out;
  }

  /* The system ring (DESIGN.md). The vendor's `a[href]:focus-visible` (0,2,1)
     draws a 3px ring with no offset and bolds the label, which would
     synthesize a weight the one-weight display serif does not ship; `[href]`
     lifts this rule to (0,3,0) so it wins. */
  .blog__link[href]:focus-visible {
    font-weight: inherit;
    outline: 2px solid var(--island);
    outline-offset: 2px;
  }
</style>
