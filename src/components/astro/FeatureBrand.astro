---
/**
 * Feature section: the person's look carries into the video and the deck.
 * Lists what Claude can read a look from, the five theme tokens and their
 * choices, and one beat drawn in two themes.
 *
 * The two drawn beats are depictions, so they are `aria-hidden`; each caption
 * names the theme it shows.
 *
 * @component FeatureBrand
 * @example
 * ```astro
 * <FeatureBrand />
 * ```
 */
import FeatureSection from '#components/astro/FeatureSection.astro'

export type Props = Record<string, never>

const SOURCES = [
  'A few words, like “light, playful, rounded”',
  'A DESIGN.md',
  'Design tokens',
  'A Figma file',
  'A reference image',
  'A reference site',
  'A square PNG logo',
]

const TOKENS: [token: string, choices: string, note?: string][] = [
  ['radius', 'sharp · soft · round'],
  ['type', 'small · regular · large'],
  ['density', 'compact · regular · airy'],
  ['background', 'glow · subtle · flat', '(video only)'],
  ['header', 'brand · logo · none'],
]

const SCENE = {
  kicker: 'The problem',
  title: 'Saving things is easy. Finding them isn’t.',
  rows: ['Too many tabs', 'Dead bookmarks', 'Messy notes'],
}
const THEMES = [
  { name: 'sharp · large · compact', modifier: 'brand__frame--sharp' },
  { name: 'round · regular · airy', modifier: 'brand__frame--round' },
]
---

<FeatureSection
  id="brand-title"
  eyebrow="Your brand"
  title="Bring your look. Every frame and slide wears it."
>
  <Fragment slot="deck">
    Claude maps what you give it to colours, fonts and a <code>theme</code>. The same theme drives
    the video and the deck.
  </Fragment>

  <div class="feature-stack" style="gap: 0.75rem">
    <p data-ui="label">Claude can work from</p>
    <ul class="feature-chips">
      {SOURCES.map(source => <li>{source}</li>)}
    </ul>
  </div>

  <div class="feature-grid" style="--feature-min: 28rem">
    <figure class="feature-specimen">
      <figcaption class="feature-specimen__bar" data-ui="label">
        <span>The five theme tokens</span>
        <span>Optional · in short.json</span>
      </figcaption>
      <div class="brand__table">
        <table class="feature-table">
          <thead>
            <tr>
              <th scope="col">Token</th>
              <th scope="col">Choices</th>
            </tr>
          </thead>
          <tbody>
            {
              TOKENS.map(([token, choices, note]) => (
                <tr>
                  <th scope="row" class="feature-mono">
                    {token}
                  </th>
                  <td class="feature-muted">
                    {choices}
                    {note && <span class="brand__note"> {note}</span>}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </figure>

    <div class="feature-stack">
      <p data-ui="label">Same beat, two themes</p>
      <div class="brand__frames">
        {
          THEMES.map(theme => (
            <figure class="brand__figure">
              <div
                class:list={['feature-frame', 'brand__frame', theme.modifier]}
                aria-hidden="true"
              >
                <span class="feature-frame__kicker">{SCENE.kicker}</span>
                <span class="feature-frame__title">{SCENE.title}</span>
                {SCENE.rows.map(row => (
                  <span class="feature-frame__row">{row}</span>
                ))}
              </div>
              <figcaption class="brand__caption">{theme.name}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>

  <div class="feature-grid">
    <div class="feature-card">
      <h3>No brand to hand?</h3>
      <p class="feature-muted">
        Claude uses the product’s logo and site. With neither, it picks a dark ground, one accent
        and one highlight from the subject, and tells you.
      </p>
    </div>
    <div class="feature-card">
      <h3>Contrast is checked</h3>
      <p class="feature-muted">
        The <code>check</code> command warns when a text colour and its fill fall under 4.5:1, and names
        both keys.
      </p>
    </div>
    <div class="feature-card">
      <h3>Restyle any time</h3>
      <p class="feature-muted">
        A theme changes no narration. Restyling after the voiceover means rendering again, not
        recording again.
      </p>
    </div>
  </div>
</FeatureSection>

<style>
  .brand__table {
    padding: 0.25rem 1.25rem 0.75rem;
  }

  .brand__note {
    font-size: 0.8125rem;
  }

  .brand__frames {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .brand__figure {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
    max-width: 100%;
    width: 11.25rem;
  }

  .brand__frame {
    aspect-ratio: 9 / 16;
    display: flex;
    flex-direction: column;
  }

  .brand__frame--sharp {
    border-radius: 0.25rem;
    gap: 0.25rem;
    padding: 0.75rem;
  }

  .brand__frame--sharp .feature-frame__title {
    font-size: 1.1875rem;
    line-height: 1.1;
    margin-block-end: 0.375rem;
  }

  .brand__frame--sharp .feature-frame__row {
    border-radius: 0;
    font-size: 0.75rem;
  }

  .brand__frame--round {
    border-radius: 1.25rem;
    gap: 0.75rem;
    padding: 1.25rem 1rem;
  }

  .brand__frame--round .feature-frame__title {
    font-size: 0.9375rem;
    line-height: 1.2;
  }

  .brand__frame--round .feature-frame__row {
    border-radius: 0.75rem;
    padding: 0.4375rem 0.625rem;
  }

  .brand__caption {
    color: var(--ink-soft);
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    line-height: 1.6;
  }
</style>
