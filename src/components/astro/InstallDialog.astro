---
/**
 * Install instructions in a native modal, upgraded from a link to the README.
 *
 * The trigger is a real link, `<a href={fallbackHref} data-opens-dialog={id}>`,
 * so without JavaScript it simply opens the README's install section. The
 * script intercepts plain clicks on matching links and calls `showModal()`
 * instead; the browser then traps focus, closes on Escape and hands focus
 * back to the link. `closedby="any"` adds light dismiss where it is supported,
 * and the close button submits a `method="dialog"` form, so no part of
 * closing needs a script.
 *
 * @component InstallDialog
 * @example
 * ```astro
 * <a href="https://github.com/shawn-sandy/oncue#install" data-opens-dialog="install">Install</a>
 * <InstallDialog
 *   id="install"
 *   commands={['/plugin marketplace add shawn-sandy/oncue', '/plugin install oncue@oncue']}
 *   fallbackHref="https://github.com/shawn-sandy/oncue#install"
 * />
 * ```
 */
import CommandBlock from '#components/astro/CommandBlock.astro'
import ExternalLink from '#components/astro/ExternalLink.astro'

export type Props = {
  /** Dialog id; trigger links name it in `data-opens-dialog`. */
  id: string
  /** Install commands, one per line. */
  commands: string[]
  /** The README section this dialog stands in for: the trigger's href and the setup-guide link. */
  fallbackHref: string
}

const { id, commands, fallbackHref } = Astro.props
const titleId = `${id}-title`
---

<dialog class="install-dialog" id={id} aria-labelledby={titleId} closedby="any" data-install-dialog>
  <form class="install-dialog__close-form" method="dialog">
    <button
      class="install-dialog__close"
      type="submit"
      aria-label="Close installation instructions"
    >
      <span aria-hidden="true">×</span>
    </button>
  </form>
  <p class="install-dialog__eyebrow" data-ui="eyebrow">Your first production</p>
  <h2 class="install-dialog__title" id={titleId}>Let’s get you on cue.</h2>
  <p>
    In Claude Code, add the marketplace and install OnCue. Then ask Claude to{' '}
    <strong>“set up OnCue”</strong> to check your tools.
  </p>
  <CommandBlock commands={commands} />
  <p>Try: “Make a 60-second explainer about my project. Use the README for facts.”</p>
  <p class="install-dialog__requirements">
    Requires Node.js 22 or newer. The final video also needs Playwright with Chromium and ffmpeg.
    ElevenLabs needs a connected account and credits; you can supply your own audio and word timings
    instead.
  </p>
  <ExternalLink href={fallbackHref}>Read the setup guide</ExternalLink>
</dialog>

<script>
  for (const dialog of document.querySelectorAll<HTMLDialogElement>(
    'dialog[data-install-dialog]'
  )) {
    for (const link of document.querySelectorAll(`a[data-opens-dialog="${dialog.id}"]`)) {
      link.addEventListener('click', event => {
        const mouse = event as MouseEvent
        // A modified or middle click still opens the README in a new tab.
        if (
          mouse.button !== 0 ||
          mouse.metaKey ||
          mouse.ctrlKey ||
          mouse.shiftKey ||
          mouse.altKey
        ) {
          return
        }
        event.preventDefault()
        dialog.showModal()
      })
    }
  }
</script>

<style>
  .install-dialog {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius, 0.5rem);
    box-sizing: border-box;
    color: var(--ink);
    max-height: calc(100dvh - 2rem);
    max-width: 38rem;
    overflow-y: auto;
    padding: 2rem;
    width: calc(100% - 2rem);
  }

  .install-dialog::backdrop {
    background: rgb(17 17 17 / 0.85);
  }

  .install-dialog > * + * {
    margin-block-start: 1rem;
  }

  /* Pinned to the corner: the vendor makes every form a full-width flex row. */
  .install-dialog .install-dialog__close-form {
    inset-block-start: 0.5rem;
    inset-inline-end: 0.5rem;
    margin: 0;
    position: absolute;
    width: auto;
  }

  /* Qualified by the root to beat the vendor's `button[type]` (0,1,1). */
  .install-dialog .install-dialog__close {
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius, 0.5rem);
    color: var(--ink);
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    min-height: 2.75rem;
    min-width: 2.75rem;
  }

  .install-dialog .install-dialog__close:hover {
    border-color: var(--rule);
  }

  .install-dialog .install-dialog__close:focus-visible {
    outline: 2px solid var(--island);
    outline-offset: 2px;
  }

  /* Clear of the close button in the corner. */
  .install-dialog .install-dialog__eyebrow {
    margin: 0;
    padding-inline-end: 3rem;
  }

  .install-dialog .install-dialog__title {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.25rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-block-start: 0.5rem;

    /* The vendor capitalizes every h1-h3. */
    text-transform: none;
  }

  .install-dialog p {
    color: var(--ink-soft);
    line-height: 1.6;
    max-width: none;
  }

  .install-dialog strong {
    color: var(--ink);
    font-weight: 600;
  }

  .install-dialog .install-dialog__requirements {
    border-block-start: 1px solid var(--rule);
    font-size: 0.875rem;
    padding-block-start: 1rem;
  }

  @media (max-width: 30rem) {
    .install-dialog {
      padding: 1.5rem 1.25rem;
    }
  }
</style>
