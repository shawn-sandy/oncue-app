---
/**
 * Homepage hero: what OnCue makes, two calls to action, and the timing demo.
 *
 * Renders inside `main` as a `section`, so the skip link lands on it. Both
 * calls to action are real links that work before any script runs:
 *
 * - "Make your first video" goes to `installHref`, the README's install
 *   section. `InstallDialog`, rendered by the page with `id="install"`,
 *   upgrades it to open a modal instead.
 * - "See it in motion" goes to `#demo`. `TimingDemo` upgrades it to play the
 *   demo from 00:00.
 *
 * Colour still marks hydration: the buttons carry the accent because they are
 * operable. The headline's accent phrase is one of the two scoped exceptions
 * (`data-accent="brand"`, see DESIGN.md); the output check marks stay in soft
 * ink.
 *
 * @component HomeHero
 * @example
 * ```astro
 * <HomeHero installHref="https://github.com/shawn-sandy/oncue#install" />
 * <InstallDialog id="install" commands={commands} fallbackHref="https://github.com/shawn-sandy/oncue#install" />
 * ```
 */
import TimingDemo from '#components/astro/TimingDemo.astro'

export type Props = {
  /** README section the install call to action opens without JavaScript. */
  installHref: string
  /** Mono eyebrow set above the headline. */
  eyebrow?: string
  /** First line of the `h1`. */
  headline?: string
  /** Second line of the `h1`, set in the italic accent. */
  headlineAccent?: string
  /** Deck paragraph, sized at a third of the headline. */
  deck?: string
}

const {
  installHref,
  eyebrow = 'A Claude Code plugin for explainer videos',
  headline = 'Every word.',
  headlineAccent = 'Right on cue.',
  deck = 'Turn a topic into a finished explainer, vertical for Shorts, Reels and TikTok or widescreen for YouTube. Script, voice and visuals stay in sync, and every card lands on the word that names it.',
} = Astro.props

const outputs = ['Storyboard', 'Voiceover', 'Editable deck', 'MP4']
---

<section class="home-hero" aria-labelledby="home-hero-title" data-home-hero>
  <div class="home-hero__lede">
    <p class="home-hero__eyebrow" data-ui="eyebrow">{eyebrow}</p>
    <h1 class="home-hero__display" id="home-hero-title" data-ui="display">
      <span>{headline}</span>{' '}
      <em class="home-hero__accent" data-accent="brand">{headlineAccent}</em>
    </h1>
    <p class="home-hero__deck" data-home-hero-deck>{deck}</p>

    <div class="home-hero__cta">
      <a class="home-hero__button" href={installHref} data-opens-dialog="install">
        Make your first video<span aria-hidden="true">↗</span>
      </a>
      <a class="home-hero__button home-hero__button--ghost" href="#demo" data-demo-start>
        <span aria-hidden="true">▷</span>See it in motion
      </a>
    </div>

    <p class="home-hero__note" data-ui="label">
      Runs in Claude Code. Your voice, your brand, your files.
    </p>
    <ul class="home-hero__outputs" aria-label="Outputs" data-ui="label">
      {outputs.map(output => <li>{output}</li>)}
    </ul>
  </div>

  <TimingDemo />
</section>

<style>
  .home-hero {
    /*
     * One knob drives both type sizes, so the display-to-deck ratio is pinned
     * at 3.2 at every viewport width rather than only at the desktop clamp.
     * The gate in e2e/homepage-design-direction.spec.ts is 3.0.
     */
    --hero-display-size: clamp(3rem, 6.6vw, 4.5rem);
    --hero-deck-size: calc(var(--hero-display-size) / 3.2);

    /*
     * Hover and pressed fills, mixed toward ink. `--ink` is near-black in light
     * and near-white in dark, so one pair of declarations darkens the accent on
     * paper and lightens it on the dark surface. Mixed in oklch so the accent
     * keeps its chroma.
     */
    --hero-island-hover: color-mix(in oklch, var(--island) 88%, var(--ink));
    --hero-island-active: color-mix(in oklch, var(--island) 78%, var(--ink));

    align-items: center;
    box-sizing: border-box;
    color: var(--ink);
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    padding-block: 2.5rem 3rem;

    /* `main > section` adds 2rem; the hero uses the site's 1.25rem gutter. */
    padding-inline: 1.25rem;
  }

  .home-hero__lede {
    min-width: 0;
  }

  .home-hero .home-hero__eyebrow {
    margin: 0 0 1.25rem;
  }

  .home-hero .home-hero__display {
    font-family: var(--font-family-display);
    font-size: var(--hero-display-size);
    font-weight: var(--font-weight-normal, 400);
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin: 0 0 1.5rem;

    /* A long word must break rather than widen the document at 320px. */
    overflow-wrap: break-word;
    text-align: left;
    text-transform: none;
  }

  .home-hero .home-hero__display > * {
    display: block;
  }

  /* The scoped brand exception: Georgia italic in the accent. */
  .home-hero .home-hero__accent {
    color: var(--island);
    font-style: italic;
  }

  .home-hero .home-hero__deck {
    color: var(--ink-soft);
    font-size: var(--hero-deck-size);
    line-height: 1.6;
    margin: 0;
    max-width: 30em;
  }

  .home-hero__cta {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2rem;
  }

  .home-hero .home-hero__button {
    align-items: center;
    background: var(--island);
    border: 1px solid var(--island);
    border-radius: var(--radius, 0.5rem);

    /* Paper, not white: white fails on the lighter dark-mode accent. */
    color: var(--paper);
    display: inline-flex;
    font-size: 0.9375rem;
    font-weight: 600;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.6875rem 1.25rem;
    text-decoration: none;
    transition:
      background-color var(--transition-duration-150, 150ms) ease-out,
      border-color var(--transition-duration-150, 150ms) ease-out;
  }

  .home-hero .home-hero__button--ghost {
    background: transparent;
    border-color: var(--rule);
    color: var(--island);
  }

  .home-hero .home-hero__button:hover {
    background: var(--hero-island-hover);
    border-color: var(--hero-island-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .home-hero .home-hero__button:active {
    background: var(--hero-island-active);
    border-color: var(--hero-island-active);
  }

  .home-hero .home-hero__button--ghost:hover {
    background: var(--island-bg);
    border-color: var(--island);
  }

  .home-hero .home-hero__button--ghost:active {
    background: color-mix(in oklch, var(--island) 18%, transparent);
    border-color: var(--island);
  }

  .home-hero .home-hero__button:focus-visible {
    outline: 2px solid var(--island);
    outline-offset: 3px;
  }

  .home-hero .home-hero__note {
    line-height: 1.6;
    margin: 1.25rem 0 0;
    text-transform: none;
  }

  .home-hero .home-hero__outputs {
    display: flex;

    /* The vendor sets every list to a column. */
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .home-hero .home-hero__outputs li {
    font-family: inherit;
    margin: 0;
    padding: 0;
  }

  .home-hero .home-hero__outputs li::before {
    content: '✓';
    content: '✓' / '';
    margin-inline-end: 0.375rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero .home-hero__button {
      transition: none;
    }
  }

  @media (max-width: 47.5rem) {
    .home-hero {
      gap: 1.5rem;
      grid-template-columns: minmax(0, 1fr);
      padding-block: 2rem;
    }
  }
</style>
